# 줄바꿈을 저장소에는 LF 로 통일한다.
# 윈도우의 core.autocrlf=true 가 gradlew(셸 스크립트)를 CRLF 로 바꿔버리면
# Git Bash/WSL/CI 에서 "bad interpreter" 로 실행이 안 된다.
* text=auto eol=lf

# 윈도우 전용 스크립트는 CRLF 유지
*.bat text eol=crlf
*.cmd text eol=crlf

# 바이너리는 건드리지 않는다
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mp3 binary
*.woff binary
*.woff2 binary
