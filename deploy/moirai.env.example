# /etc/moirai/moirai.env 로 복사하고 값을 채운다.
#
#   sudo mkdir -p /etc/moirai
#   sudo cp moirai.env.example /etc/moirai/moirai.env
#   sudo chown root:moirai /etc/moirai/moirai.env
#   sudo chmod 640 /etc/moirai/moirai.env
#
# 비밀번호가 들어 있다. 이 파일(.example)만 깃에 들어가고 실제 파일은 안 들어간다.

SPRING_PROFILES_ACTIVE=prod

# 앱과 DB 가 같은 서버에 있으므로 localhost 다.
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/moirai
DATABASE_USERNAME=moirai
DATABASE_PASSWORD=여기에_DB_비밀번호

# 비워 두면 앱이 뜨지 않는다. 의도된 동작이다.
ADMIN_USERNAME=여기에_관리자_아이디
ADMIN_PASSWORD=여기에_긴_비밀번호

# nginx 만 통하게 한다. 0.0.0.0 으로 열면 8080 으로 직접 들어올 수 있고,
# 그러면 X-Forwarded-Proto 를 아무나 위조할 수 있다.
#
# !!! 이 두 줄은 직접 띄우는 서버(Oracle 등) 전용이다. !!!
# Railway 같은 PaaS 에 넣으면 플랫폼 프록시가 컨테이너 밖에서 못 들어와
# "no healthy upstream" 이 뜬다. 거기서는 둘 다 넣지 않는다.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
